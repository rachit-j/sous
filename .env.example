# Copy to .env and fill in only the providers you use. Never commit .env.

# Local Ollama (no key required). Must be an installed image-capable model; Sous never downloads models.
# The first request may take a while (up to 180 s) while a cold model loads into memory.
# OLLAMA_BASE_URL defaults to http://localhost:11434; leave it commented unless Ollama runs elsewhere.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AWS Bedrock Converse (credentials come from the standard AWS chain)
AWS_REGION=
BEDROCK_MODEL_ID=
# AWS_PROFILE=

# Optional overrides. By default the database and a generated secret key live in instance/.
# SOUS_DATABASE=
# SOUS_SECRET_KEY=
