# Copy to .env to configure local Ollama or Docker. Never commit .env.
# AWS connections belong to signed-in accounts in Settings; do not configure shared cloud credentials here.

# Host port for Docker (published on 127.0.0.1 only). Default 5050 because macOS uses 5000.
# SOUS_PORT=5050

# Local Ollama (no key required). Must be an installed image-capable model; Sous never downloads models.
# The first request may take a while (up to 180 s) while a cold model loads into memory.
# Leave OLLAMA_BASE_URL commented: the app defaults to http://localhost:11434 when run directly, and
# Docker Compose defaults to http://host.docker.internal:11434 (your host's Ollama). Setting it to
# localhost here would point Docker at the container itself.
# OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3-vl:8b

# Optional overrides. By default the database and a generated secret key live in instance/
# (a named volume under Docker).
# SOUS_DATABASE=
# SOUS_SECRET_KEY=
